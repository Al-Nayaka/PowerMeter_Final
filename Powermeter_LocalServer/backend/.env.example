# Runtime defaults bind loopback; expose through the reviewed LAN reverse proxy.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000

# POSTGRESQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=powermeter_db
DB_USER=postgres
DB_PASSWORD=your_database_password

# MQTT
MQTT_URL=mqtt://localhost:1883
MQTT_USERNAME=powermeter-backend
MQTT_PASSWORD=
MQTT_CLIENT_ID=powermeter-backend
MQTT_MAX_PAYLOAD_BYTES=4096
MQTT_MAX_PENDING=100

# Generate your own secret. Empty disables all administrative/relay writes.
# Production requires at least 32 characters. Never use MQTT credentials here.
ADMIN_API_KEY=
ALLOWED_ORIGINS=http://localhost:5173
HISTORY_MAX_LIMIT=1000
DEVICE_OFFLINE_SECONDS=45
RELAY_TIMEOUT_SECONDS=10
